          "text": [
            "=== 超市商品 ===\n",
            "蘋果：50元\n",
            "香蕉：30元\n",
            "牛奶：60元\n",
            "麵包：40元\n",
            "請輸入商品名稱（輸入 / 結束）：乃\n",
            "找不到商品\n",
            "請輸入商品名稱（輸入 / 結束）：牛奶\n",
            "請輸入商品名稱（輸入 / 結束）：/\n",
            "牛奶 數量：1，單項小計：60 元\n",
            "總金額：60 元\n"
          ]
        }
      ],
      "source": [
        "products = {\"蘋果\": 50, \"香蕉\": 30, \"牛奶\": 60, \"麵包\": 40}\n",
        "\n",
        "print(\"=== 超市商品 ===\")\n",
        "for name, price in products.items():\n",
        "    print(f\"{name}：{price}元\")\n",
        "\n",
        "cart = {}\n",
        "while True:\n",
        "    item = input(\"請輸入商品名稱（輸入 / 結束）：\")\n",
        "    if item == \"/\":\n",
        "        break\n",
        "    if item in products:\n",
        "        cart[item] = cart.get(item, 0) + 1\n",
        "    else:\n",
        "        print(\"找不到商品\")\n",
        "\n",
        "total = 0\n",
        "for item, qty in cart.items():\n",
        "    subtotal = products[item] * qty\n",
        "    total += subtotal\n",
        "    print(f\"{item} 數量：{qty}，單項小計：{subtotal} 元\")\n",
        "\n",
        "print(f\"總金額：{total} 元\")"
      ]
    }
  ]
