        "\n",
        "weapons = [\"木棒\", \"手槍\", \"霰彈槍\", \"狙擊槍\", \"雷射劍\"]\n",
        "attacks = [10, 30, 50, 80, 100]\n",
        "\n",
        "\n",
        "for i in range(len(weapons)):\n",
        "    print(f\"{i + 1} {weapons[i]}\")\n",
        "\n",
        "\n",
        "while True:\n",
        "    try:\n",
        "        choice = int(input(\"請輸入武器編號（0 結束）：\"))\n",
        "    except ValueError:\n",
        "        print(\"請輸入有效的數字\")\n",
        "        continue\n",
        "\n",
        "    if choice == 0:\n",
        "        break\n",
        "    elif 1 <= choice <= len(weapons):\n",
        "        index = choice - 1\n",
        "        print(f\"{weapons[index]} 的攻擊力是 {attacks[index]}\")\n",
        "    else:\n",
        "        print(\"找不到武器\")\n",
        "\n",
        "avg_attack = sum(attacks) / len(attacks)\n",
        "print(f\"平均攻擊力： {avg_attack:.1f}\")"
      ],
